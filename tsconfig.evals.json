{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true
  },
  "include": [
    "evals/**/*.ts",
    "server/openclawRouter.ts",
    "server/capabilityRegistry.ts",
    "server/security.ts",
    "server/executionState.ts",
    "server/skillContract.ts"
  ]
}
