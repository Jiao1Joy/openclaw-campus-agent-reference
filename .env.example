# Standalone campus API
CAMPUS_HOST=127.0.0.1
CAMPUS_PORT=8787
CAMPUS_ALLOWED_ORIGINS=http://127.0.0.1:4173
CAMPUS_WORKSPACE=./openclaw-workspace

# Use demo only on a developer workstation. Shared environments should use OIDC.
CAMPUS_AUTH_MODE=oidc
CAMPUS_AUTH_SECRET=
CAMPUS_AUDIT_SECRET=

# School OIDC / JWKS configuration
CAMPUS_OIDC_ISSUER=https://sso.example.edu
CAMPUS_OIDC_AUDIENCE=campus-api
CAMPUS_OIDC_JWKS_URI=https://sso.example.edu/.well-known/jwks.json
CAMPUS_OIDC_STUDENT_ID_CLAIM=sub
CAMPUS_OIDC_NAME_CLAIM=name
CAMPUS_OIDC_COLLEGE_CLAIM=college
CAMPUS_OIDC_CLASS_NAME_CLAIM=className
CAMPUS_OIDC_ROLES_CLAIM=roles
CAMPUS_OIDC_CLOCK_TOLERANCE_SECONDS=30
CAMPUS_OIDC_JWKS_CACHE_SECONDS=300

# Timeouts and evidence retention
CAMPUS_OPENCLAW_TIMEOUT_MS=120000
CAMPUS_ENGINE_TIMEOUT_MS=20000
CAMPUS_IDEMPOTENCY_TTL_MS=86400000
CAMPUS_EXECUTION_TTL_MS=1800000
CAMPUS_TRACE_FILE=./openclaw-workspace/data/traces/campus-traces.jsonl
CAMPUS_COURSE_ROLLBACK_WINDOW_MINUTES=30

# Intent router. small-model calls a local OpenAI-compatible endpoint directly
# (10-15s budget) and degrades to deterministic regex rules on timeout, JSON
# errors, contradictions or low confidence; openclaw keeps the CLI agent turn.
CAMPUS_OPENCLAW_ROUTER_BACKEND=small-model
CAMPUS_OPENCLAW_ROUTER_FALLBACK=deterministic
CAMPUS_OPENCLAW_ROUTER_TIMEOUT_MS=15000
CAMPUS_ROUTER_MODEL_URL=http://127.0.0.1:8080/v1
CAMPUS_ROUTER_MODEL_NAME=llama3.1-8b
CAMPUS_ROUTER_MODEL_TIMEOUT_MS=12000
CAMPUS_ROUTER_MODEL_API_KEY=

# Structured leave previews expire and must be regenerated before submit.
CAMPUS_PREVIEW_TTL_MS=600000

# Demo campus-admin console (/admin). The password never ships in the repo.
CAMPUS_DEMO_ADMIN_USERNAME=campus-admin
CAMPUS_DEMO_ADMIN_PASSWORD=
# At least 32 bytes; falls back to CAMPUS_AUTH_SECRET when unset.
CAMPUS_DEMO_ADMIN_TOKEN_SECRET=
CAMPUS_DEMO_ADMIN_TOKEN_TTL_MINUTES=120

# Separate campus-admin Agent. The approval watcher starts the Agent-owned
# deterministic Skill directly by default; use openclaw only to demo an LLM
# turn before the same Skill is called. Chat remains an OpenClaw Agent turn.
CAMPUS_ADMIN_AGENT_WORKER_ENABLED=true
CAMPUS_ADMIN_APPROVAL_MODE=skill-direct
CAMPUS_ADMIN_CHAT_MODE=openclaw
CAMPUS_ADMIN_AGENT_TIMEOUT_MS=90000

# Frontend build-time configuration
VITE_CAMPUS_API_BASE_URL=http://127.0.0.1:8787
